{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "matter-qr-app",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-09-24",
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "run_worker_first": ["/api/dcl/*"],
    "not_found_handling": "404-page"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
